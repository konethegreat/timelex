# Written by Kone Tshivhinda & Claude
# The service image builds from crates/, services/, contracts/ and the Postgres bootstrap; keep the
# context small and never send local secrets or build output to the daemon.
.git
.github
target
node_modules
**/dist
**/.env
**/.env.*
workers
eval
docs
packages
plugin
# The workspace manifest names tools/new-service, so cargo needs its manifest even when only the
# service binaries are built. The SDK generator and the link checker stay out of the context.
tools/sdk-gen
tools/check_links.py
*.pem
