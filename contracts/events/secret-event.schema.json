{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/konethegreat/timelex/contracts/events/secret-event.schema.json",
  "title": "SecretEvent",
  "description": "Fact about one of a firm's provider secrets: created, updated, tested, rotated or revoked. Never carries a value. Delivery is at least once; a consumer records the ids it has applied. Written by Kone Tshivhinda & Claude.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "source", "tenantId", "time", "actor", "data"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Major version 1. Additive changes bump the minor; breaking changes need a new major."
    },
    "id": {
      "type": "string",
      "pattern": "^ev_[0-9a-f]{32}$",
      "description": "Event id. The relay may deliver an event more than once; a consumer dedupes on this id."
    },
    "type": {
      "type": "string",
      "enum": ["secret.created", "secret.updated", "secret.tested", "secret.rotated", "secret.revoked"]
    },
    "source": { "type": "string", "const": "vault" },
    "tenantId": { "type": "string", "pattern": "^tn_[0-9A-Za-z]{8,64}$" },
    "time": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId"],
      "properties": { "userId": { "type": "string", "pattern": "^us_[0-9A-Za-z]{8,64}$" } }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretId", "kind", "label", "lastFour"],
      "properties": {
        "secretId": { "type": "string", "format": "uuid" },
        "kind": {
          "type": "string",
          "enum": ["anthropic_api_key", "m365_oauth", "google_oauth", "generic_api_key"]
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "lastFour": { "type": "string", "maxLength": 4 },
        "result": {
          "type": "string",
          "enum": ["passed", "failed"],
          "description": "Present only on secret.tested: how the provider check ended."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "secret.tested" } },
        "required": ["type"]
      },
      "then": { "properties": { "data": { "required": ["result"] } } },
      "else": { "properties": { "data": { "not": { "required": ["result"] } } } }
    }
  ]
}
