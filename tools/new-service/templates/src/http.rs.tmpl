//! The @name@ service's HTTP layer.
//!
//! Every route except `/health` demands an internal token signed by the gateway (ADR-0012) and
//! accepts only a tenant principal. The firm and user come from the verified token, never from the
//! request. `/v1/items` is the generated example: replace it with the operations of your contract.

use std::sync::Arc;

use axum::extract::rejection::JsonRejection;
use axum::extract::{DefaultBodyLimit, FromRequest, FromRequestParts, Request, State};
use axum::http::{header, request::Parts, HeaderValue, StatusCode};
use axum::response::{IntoResponse, Response};
use axum::routing::get;
use axum::{Json, Router};
use serde::{Deserialize, Serialize};
use serde_json::json;
use time::OffsetDateTime;
use timelex_auth::{Caller, Kind, Verifier};
use uuid::Uuid;

use crate::error::StoreError;
use crate::store::{Actor, Item, Store};

/// Largest request body accepted (also enforced at the gateway).
pub const MAX_BODY_BYTES: usize = 64 * 1024;

/// What every handler needs.
#[derive(Clone)]
pub struct AppState {
    store: Store,
    verifier: Arc<Verifier>,
}

/// Build the router. Kept apart from `main` so tests can call it without a socket.
pub fn router(store: Store, verifier: Verifier) -> Router {
    let router = Router::new()
        .route("/health", get(health))
        .route("/v1/items", get(list_items).post(create_item))
        .fallback(|| async { ApiError::NotFound })
        .layer(DefaultBodyLimit::max(MAX_BODY_BYTES))
        .with_state(AppState {
            store,
            verifier: Arc::new(verifier),
        });
    timelex_telemetry::instrument(router, "@name@")
}

// ---------- errors: RFC 9457 problem details ----------

/// Every failure the HTTP layer can report. Bodies never contain secrets or internal details.
#[derive(Debug)]
pub enum ApiError {
    Unauthorized,
    Forbidden,
    BadRequest(String),
    NotFound,
    TooLarge,
    Unavailable,
    Internal,
}

impl IntoResponse for ApiError {
    fn into_response(self) -> Response {
        let (status, slug, title, detail): (StatusCode, &str, &str, Option<String>) = match self {
            ApiError::Unauthorized => (StatusCode::UNAUTHORIZED, "unauthenticated", "Unauthorized", None),
            ApiError::Forbidden => (StatusCode::FORBIDDEN, "forbidden", "Forbidden", None),
            ApiError::BadRequest(detail) => (
                StatusCode::BAD_REQUEST,
                "invalid-request",
                "Invalid request",
                Some(detail),
            ),
            ApiError::NotFound => (StatusCode::NOT_FOUND, "not-found", "Not found", None),
            ApiError::TooLarge => (
                StatusCode::PAYLOAD_TOO_LARGE,
                "too-large",
                "Request too large",
                None,
            ),
            ApiError::Unavailable => (
                StatusCode::SERVICE_UNAVAILABLE,
                "unavailable",
                "Service unavailable",
                None,
            ),
            ApiError::Internal => (
                StatusCode::INTERNAL_SERVER_ERROR,
                "internal",
                "Internal error",
                None,
            ),
        };
        let mut body = json!({
            "type": format!("urn:timelex:problem:{slug}"),
            "title": title,
            "status": status.as_u16(),
        });
        if let Some(detail) = detail {
            body["detail"] = detail.into();
        }
        let mut response = (status, Json(body)).into_response();
        response.headers_mut().insert(
            header::CONTENT_TYPE,
            HeaderValue::from_static("application/problem+json"),
        );
        if status == StatusCode::UNAUTHORIZED {
            response
                .headers_mut()
                .insert(header::WWW_AUTHENTICATE, HeaderValue::from_static("Bearer"));
        }
        response
    }
}

impl From<StoreError> for ApiError {
    fn from(error: StoreError) -> Self {
        match error {
            StoreError::Invalid(message) => ApiError::BadRequest(message.to_owned()),
            StoreError::NotFound => ApiError::NotFound,
            StoreError::Internal(message) => {
                tracing::error!(error = %message, "store failure");
                ApiError::Internal
            }
        }
    }
}

// ---------- authentication of the *caller* (the gateway) ----------

/// A verified internal token. Extracting it is what "this route needs a caller" means.
struct Verified(Caller);

impl FromRequestParts<AppState> for Verified {
    type Rejection = ApiError;

    async fn from_request_parts(parts: &mut Parts, state: &AppState) -> Result<Self, ApiError> {
        let token = parts
            .headers
            .get(header::AUTHORIZATION)
            .and_then(|value| value.to_str().ok())
            .and_then(|value| value.strip_prefix("Bearer "))
            .ok_or(ApiError::Unauthorized)?;
        match state.verifier.verify(token) {
            Ok(verified) => Ok(Verified(verified.caller)),
            Err(reason) => {
                // The reason is for the operator; the caller always gets the same 401.
                tracing::warn!(?reason, "internal token rejected");
                Err(ApiError::Unauthorized)
            }
        }
    }
}

impl Verified {
    /// Require a specific kind of caller; a valid token of another kind is a 403.
    fn require(self, kind: Kind) -> Result<Caller, ApiError> {
        if self.0.kind() == kind {
            Ok(self.0)
        } else {
            Err(ApiError::Forbidden)
        }
    }

    fn require_principal(self) -> Result<Actor, ApiError> {
        match self.require(Kind::Principal)? {
            Caller::Principal(principal) => Ok(Actor::from(&principal)),
            _ => Err(ApiError::Forbidden),
        }
    }
}

/// `Json<T>` with our error bodies. The detail is fixed text: serde's own message can echo values.
struct Body<T>(T);

impl<T, S> FromRequest<S> for Body<T>
where
    Json<T>: FromRequest<S, Rejection = JsonRejection>,
    S: Send + Sync,
{
    type Rejection = ApiError;

    async fn from_request(req: Request, state: &S) -> Result<Self, ApiError> {
        match Json::<T>::from_request(req, state).await {
            Ok(Json(value)) => Ok(Body(value)),
            Err(rejection) if rejection.status() == StatusCode::PAYLOAD_TOO_LARGE => Err(ApiError::TooLarge),
            Err(_) => Err(ApiError::BadRequest(
                "the request body is not valid for this operation".into(),
            )),
        }
    }
}

// ---------- wire types (camelCase JSON) ----------

#[derive(Deserialize)]
#[serde(deny_unknown_fields)]
struct CreateItemBody {
    name: String,
}

#[derive(Serialize)]
#[serde(rename_all = "camelCase")]
struct ItemJson {
    id: Uuid,
    name: String,
    #[serde(with = "time::serde::rfc3339")]
    created_at: OffsetDateTime,
}

impl From<&Item> for ItemJson {
    fn from(item: &Item) -> Self {
        Self {
            id: item.id,
            name: item.name.clone(),
            created_at: item.created_at,
        }
    }
}

// ---------- handlers ----------

async fn health(State(state): State<AppState>) -> Result<Json<serde_json::Value>, ApiError> {
    state.store.ping().await.map_err(|_| ApiError::Unavailable)?;
    Ok(Json(json!({ "status": "ok" })))
}

async fn list_items(
    State(state): State<AppState>,
    caller: Verified,
) -> Result<Json<Vec<ItemJson>>, ApiError> {
    let actor = caller.require_principal()?;
    let items = state.store.list(actor).await?;
    Ok(Json(items.iter().map(ItemJson::from).collect()))
}

async fn create_item(
    State(state): State<AppState>,
    caller: Verified,
    Body(body): Body<CreateItemBody>,
) -> Result<(StatusCode, Json<ItemJson>), ApiError> {
    let actor = caller.require_principal()?;
    let item = state.store.create(actor, &body.name).await?;
    Ok((StatusCode::CREATED, Json(ItemJson::from(&item))))
}
